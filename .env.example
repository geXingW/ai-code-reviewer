APP_NAME=ai-code-reviewer
APP_VERSION=0.1.0-dev
DEBUG=false
LOG_LEVEL=INFO

# PostgreSQL
# Docker Compose overrides host names for container networking. Keep localhost values for local dev.
DATABASE_URL=postgresql+asyncpg://ai_reviewer:ai_reviewer@localhost:5432/ai_code_reviewer
POSTGRES_USER=ai_reviewer
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=ai_code_reviewer

# MySQL 备选（切换 DATABASE_URL 即可，不用同时开两个 DB）
# DATABASE_URL=mysql+aiomysql://ai_reviewer:ai_reviewer@localhost:3306/ai_code_reviewer
MYSQL_ROOT_PASSWORD=ai_reviewer_root
MYSQL_DATABASE=ai_code_reviewer
MYSQL_USER=ai_reviewer
MYSQL_PASSWORD=ai_reviewer

# 【必须】Fernet 密钥，用于加密 provider.api_key / project.gitlab_access_token / project.webhook_secret
# 生成方式（推荐）:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 未设置或格式非法时应用将拒绝启动。
SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_FERNET_KEY

# GitLab integration
# 注意：GITLAB_BASE_URL / GITLAB_TOKEN / GITLAB_WEBHOOK_SECRET 已下沉到项目级配置，
# 在管理台创建/编辑项目时设置。每个项目可独立对接不同的 GitLab 实例。

# Internal management / Jenkins API token.
# Frontend asks for this token in memory only; do not store it in browser storage.
INTERNAL_API_TOKEN=CHANGE...OKEN

# Admin management API authentication (JWT)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE...WORD
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE...BYTES
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=86400

# Review runtime
# 可选值：llm-direct（纯 diff 单轮）/ llm-agent（多轮工具调用，能调查影响范围，token 成本更高）
DEFAULT_REVIEW_ENGINE=llm-direct
# llm-agent 引擎护栏（仅 DEFAULT_REVIEW_ENGINE=llm-agent 时生效）
AGENT_MAX_TURNS=8
AGENT_TOOL_RESULT_MAX_CHARS=8000
AGENT_TOTAL_CONTEXT_MAX_CHARS=120000
AGENT_TOOL_TIMEOUT_SECONDS=15
# llm-agent 执行轨迹观测（stdout 结构化日志 + agent_trace_events 表）
AGENT_TRACE_ENABLED=true
AGENT_TRACE_DB_ENABLED=true
AGENT_TRACE_CONTENT_MAX_CHARS=20000
CORS_ORIGINS=["http://localhost:5173"]
BACKEND_RELOAD=false
